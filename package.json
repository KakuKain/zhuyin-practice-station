{
  "name": "zhuyin-practice-station",
  "version": "0.1.0-beta.2",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:unit && npm run build && npm run test:rendered",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:rendered": "node --test tests/rendered-html.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test:unit",
    "format": "prettier --write app components features lib styles tooling tests *.ts *.mjs *.json",
    "assets:artwork": "node scripts/optimize-artwork.mjs",
    "assets:progressive": "node scripts/prepare-progressive-artwork.mjs",
    "assets:audio-registry": "tsx scripts/build-audio-registry.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "prettier": "3.9.9",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "0.35.5",
    "tailwindcss": "4.2.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
