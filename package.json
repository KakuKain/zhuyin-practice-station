{
  "name": "zhuyin-practice-station",
  "version": "0.2.0-beta.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-build.mjs",
    "preview": "vite preview",
    "test": "npm run check && npm run build",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test:unit",
    "format": "prettier --write app components features lib styles tests scripts *.ts *.mjs *.json",
    "format:check": "prettier --check app components features lib styles tests scripts *.ts *.mjs *.json",
    "assets:artwork": "node scripts/optimize-artwork.mjs",
    "assets:progressive": "node scripts/prepare-progressive-artwork.mjs",
    "assets:audio-registry": "tsx scripts/build-audio-registry.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "prettier": "3.9.9",
    "sharp": "0.35.5",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.16"
  },
  "type": "module"
}
